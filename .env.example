# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=adsagent
POSTGRES_PASSWORD=adsagent_secret
POSTGRES_DB=adsagent_db
DATABASE_URL=postgresql+asyncpg://adsagent:adsagent_secret@localhost:5432/adsagent_db
SYNC_DATABASE_URL=postgresql+psycopg2://adsagent:adsagent_secret@localhost:5432/adsagent_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256


# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "google" or "openai"
LLM_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL_GOOGLE=gemini-1.5-pro
LLM_MODEL_OPENAI=gpt-4o

# ── MLflow ─────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Storage ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=100

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AI Autonomous Data Scientist Agent
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
